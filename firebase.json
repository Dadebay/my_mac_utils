{
  "firestore": {
    "rules": "mac_utils/backend/firestore.rules"
  },
  "functions": [
    {
      "source": "mac_utils/backend/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "mac_utils/website/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin-api/**",
        "function": {
          "functionId": "adminApi",
          "region": "europe-west1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/en",
        "type": 302
      },
      {
        "source": "/destek",
        "destination": "/en/destek",
        "type": 301
      },
      {
        "source": "/gizlilik-politikasi",
        "destination": "/en/gizlilik-politikasi",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
