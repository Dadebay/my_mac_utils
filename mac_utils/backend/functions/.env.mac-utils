# Panelin gerçekte servis edildiği Hosting origin'i. Gizli değil —
# CSRF/same-origin kontrolü buna bakıyor.
#
# Koddaki varsayılan `https://glassdo.app`, ama site şu an
# mac-utils.web.app adresinde. Bu dosya olmadan giriş isteği
# same-origin kontrolüne takılırdı.
ADMIN_ALLOWED_ORIGIN=https://mac-utils.web.app
