# Bu dosya bir örnektir — gerçek değerler `.env.<proje-alias>` (ör.
# `.env.production`, `.env.staging`) olarak kopyalanır ve Git'e girmez.
# Yalnızca GİZLİ OLMAYAN parametreler burada durur; gerçek secret'lar
# (RevenueCat key'leri, admin parola hash'i, session imzalama anahtarı,
# promo pepper) `firebase functions:secrets:set <ADI> --project <alias>`
# ile Secret Manager'a girilir, bu dosyaya asla yazılmaz.

ADMIN_ALLOWED_ORIGIN=https://glassdo.app

# Gerçek değer proje başına `.env.<proje-id>` dosyasında; mac-utils için
# `.env.mac-utils` sürüm denetiminde duruyor (gizli bir şey içermiyor).
