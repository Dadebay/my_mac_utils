---
import "../styles/global.css";
import { locales, htmlLang, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Dil öneki olmadan sayfa yolu: "" (ana sayfa), "destek", … */
  path?: string;
  /** Arama sonuçlarında istenmeyen sayfalar (ör. yönetim paneli). */
  noindex?: boolean;
  /** Sayfaya özel ek yapısal veri (ana sayfada SSS işaretlemesi). */
  schema?: Record<string, unknown>;
}

const { lang, title, description, path = "", noindex = false, schema } = Astro.props;

const site = Astro.site ?? new URL("https://mac-utils.web.app");
const suffix = path ? `/${path}` : "";
const canonical = new URL(`/${lang}${suffix}`, site);

/**
 * Üç dil birbirinin çevirisi olduğu için her sayfa diğer ikisini
 * `hreflang` ile işaret ediyor. Bu olmadan arama motorları üç sayfayı
 * ayrı ayrı sıralamaya sokup birbirinin kopyası sanabiliyor — çok dilli
 * bir sitede en sık yapılan hata bu.
 */
const alternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(`/${l}${suffix}`, site).href,
}));

const ogImage = new URL("/og.png", site).href;

/**
 * Yapısal veri: arama motoruna bunun bir uygulama olduğunu, hangi
 * platformda çalıştığını ve ücretsiz olduğunu söylüyor.
 */
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "GlassDo",
  applicationCategory: "ProductivityApplication",
  operatingSystem: "macOS 26",
  description,
  url: canonical.href,
  inLanguage: htmlLang[lang],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Dadebay", url: "https://github.com/Dadebay" },
};
---

<!doctype html>
<html lang={htmlLang[lang]} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {/* Dili eşleşmeyen ziyaretçi İngilizce sürüme gitsin. */}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${suffix}`, site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GlassDo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0b0f" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {/* Başlıkta kullanılan iki ağırlık önden yükleniyor: yazı tipi geç
        gelirse metin önce sistem fontuyla çizilip sonra kayıyor. */}
    <link rel="preload" href="/fonts/gilroy/Gilroy-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/gilroy/Gilroy-SemiBold.ttf" as="font" type="font/ttf" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Beliren bölümler yalnızca betik çalışırsa gizleniyor; bu satır
        `<head>` içinde, ilk boyamadan önce çalışıyor ki içerik önce
        görünüp sonra kaybolmasın. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="flex min-h-dvh flex-col bg-background font-sans text-foreground antialiased">
    <slot />

    {/* Harfleri kum tanelerine ayıran parçacık sistemi. */}
    <script>
      import "../scripts/sand";
    </script>

    {/*
      Kum taneciği maskesini nav bar'ın altına sabitle.

      Maske, maskelenen öğenin kendi kutusuna göre konumlanıyor; öğe
      sayfayla birlikte kaydığı için bandın viewport'ta sabit durması adına
      her karede öğenin üst kenarına olan uzaklığı yazıyoruz. Kare başına
      iki özellik yazımı — scroll dinleyicisi `passive` ve iş rAF'a
      toplanıyor, yani kaydırma bloke edilmiyor.
    */}
    <script is:inline>
      (() => {
        const roots = document.querySelectorAll("[data-dissolve-root]");
        if (!roots.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        /* Nav bar'ın alt hizası: üst boşluk + yüksekliği. */
        const navBottom = 88;
        let queued = false;

        const update = () => {
          queued = false;
          for (const root of roots) {
            const band = parseFloat(getComputedStyle(root).getPropertyValue("--dissolve-band")) || 0;
            const offset = navBottom - root.getBoundingClientRect().top;
            /*
             * Alt sınır -bant: öğe tamamen nav'ın altındayken bant öğenin
             * üstüne, görünmez bir yere çekiliyor. Daha yukarı taşınırsa
             * bandın altındaki opak katman öğenin alt ucuna yetişemiyor ve
             * sayfanın dibi kesiliyor.
             */
            root.style.setProperty("--dissolve-y", Math.max(-band, offset) + "px");
          }
        };

        const schedule = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        };

        update();
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule);
      })();
    </script>

    {/*
      Beliren bölümleri görünür alana girdikçe aç.

      İki şey önemli: bölümler ekrana girmeden epey önce (600px) açılmaya
      başlıyor ve hızlı kaydırmada beliriş tamamen atlanıyor. Öncesinde
      hızlı kaydırınca ekranlar dolusu içerik yarım saniye boyunca
      saydam kalıyor, yani "yetişemiyordu".
    */}
    <script is:inline>
      (() => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length) return;

        const reveal = (element) => element.classList.add("is-visible");

        if (!("IntersectionObserver" in window)) {
          items.forEach(reveal);
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              reveal(entry.target);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "600px 0px 600px 0px" },
        );

        items.forEach((item) => observer.observe(item));

        /* Kaydırma bir karede 300 pikselden fazla atladıysa beliriş
           kuyruğa girmesin: kalan her şey anında açılıyor. */
        let previous = window.scrollY;
        addEventListener(
          "scroll",
          () => {
            const jump = Math.abs(window.scrollY - previous);
            previous = window.scrollY;
            if (jump < 300) return;
            document.documentElement.classList.add("reveal-instant");
            items.forEach(reveal);
            observer.disconnect();
          },
          { passive: true },
        );
      })();
    </script>

  </body>
</html>
