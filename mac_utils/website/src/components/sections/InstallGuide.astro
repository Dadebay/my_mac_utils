---
import Icon from "../Icon.astro";
import Reveal from "../Reveal.astro";

interface Props {
  installGuide: {
    title: string;
    steps: { title: string; description: string }[];
    gatekeeperTitle: string;
    gatekeeperDescription: string;
  };
}
const { installGuide } = Astro.props;
---

<section class="px-4 py-16">
  <div class="mx-auto max-w-4xl">
    <Reveal>
      <h2 class="text-center text-2xl font-semibold tracking-tight sm:text-3xl">{installGuide.title}</h2>
    </Reveal>

    <ol class="mt-10 grid gap-4 sm:grid-cols-4">
      {
        installGuide.steps.map((step, index) => (
          <li>
            <Reveal>
              <div class="glass-panel h-full rounded-2xl p-5">
                <span class="text-xs text-accent-blue">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="mt-2 font-medium">{step.title}</h3>
                <p class="mt-1 text-sm text-foreground-muted">{step.description}</p>
              </div>
            </Reveal>
          </li>
        ))
      }
    </ol>

    <Reveal class="mt-6">
      <div class="glass-panel flex items-start gap-3 rounded-2xl p-5">
        <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-accent-blue" strokeWidth={1.75} />
        <div>
          <h3 class="font-medium">{installGuide.gatekeeperTitle}</h3>
          <p class="mt-1 text-sm text-foreground-muted">{installGuide.gatekeeperDescription}</p>
        </div>
      </div>
    </Reveal>
  </div>
</section>
