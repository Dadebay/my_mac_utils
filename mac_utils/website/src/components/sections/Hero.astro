---
import Mockup from "../Mockup.astro";
import Reveal from "../Reveal.astro";
import { anchors } from "../../i18n/ui";

interface Props {
  hero: {
    title: string;
    subtitle: string;
    primaryCta: string;
    secondaryCta: string;
    note: string;
    mockupLabel: string;
  };
}
const { hero } = Astro.props;
---

<section class="relative overflow-hidden px-4 pb-20 pt-40 sm:pt-48">
  <div class="glow-violet pointer-events-none absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-3xl text-center">
    <h1 class="text-balance text-4xl font-semibold tracking-tight sm:text-6xl">{hero.title}</h1>
    <p class="mx-auto mt-6 max-w-xl text-balance text-lg text-foreground-muted">{hero.subtitle}</p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={`#${anchors.download}`}
        class="rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-opacity duration-200 hover:opacity-90 active:scale-95"
      >
        {hero.primaryCta}
      </a>
      <a
        href={`#${anchors.features}`}
        class="rounded-full border border-glass-border px-6 py-3 text-sm font-medium text-foreground-muted transition-colors duration-200 hover:text-foreground active:scale-95"
      >
        {hero.secondaryCta}
      </a>
    </div>

    <p class="mt-4 text-xs text-foreground-subtle">{hero.note}</p>
  </div>

  <Reveal class="relative mx-auto mt-16 max-w-4xl">
    {/* Kapak görseli gecikmeli yüklenmiyor: sayfanın en büyük öğesi bu
        (LCP) ve geç gelmesi doğrudan hız puanına yazılıyor. */}
    <Mockup src="/screenshots/hero.png" alt={hero.mockupLabel} ratio="16/9" eager />
  </Reveal>
</section>
