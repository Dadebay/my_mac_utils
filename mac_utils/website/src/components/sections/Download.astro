---
import Icon from "../Icon.astro";
import Reveal from "../Reveal.astro";
import { anchors, releasesUrl, latestReleaseUrl } from "../../i18n/ui";

interface Props {
  download: {
    title: string;
    description: string;
    releaseNotesLabel: string;
    requirementsLabel: string;
    architectureLabel: string;
    trustBadge: string;
    unsignedNotice: string;
    privacyMicrocopy: string;
  };
}
const { download } = Astro.props;
---

<section id={anchors.download} class="px-4 py-24">
  <Reveal class="mx-auto max-w-2xl text-center">
    <div class="glass-panel glass-panel-lg rounded-3xl p-10">
      <h2 class="text-3xl font-semibold tracking-tight">{download.title}</h2>
      <p class="mt-3 text-foreground-muted">{download.description}</p>

      {/*
        Eski sürümde bu buton en son sürümün adresini tarayıcıda
        JavaScript ile çekiyordu; bulamazsa hata metni gösteriyordu.
        GitHub'ın `releases/latest` adresi zaten aynı yere yönlendiriyor,
        yani aynı iş ağ isteği olmadan ve her durumda çalışıyor.
      */}
      <a
        href={latestReleaseUrl}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-foreground px-7 py-3.5 text-sm font-medium text-background transition-opacity duration-200 hover:opacity-90 active:scale-95"
      >
        <Icon name="download" class="h-4 w-4" />
        {download.title}
      </a>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-foreground-subtle">
        <span class="flex items-center gap-1">
          <Icon name="cpu" class="h-3.5 w-3.5" />
          {download.architectureLabel}
        </span>
        <span>{download.requirementsLabel}</span>
      </div>

      <a
        href={releasesUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-4 block text-xs text-foreground-subtle underline underline-offset-4 hover:text-foreground-muted"
      >
        {download.releaseNotesLabel}
      </a>

      <div class="mt-6 border-t border-glass-border pt-6">
        <p class="flex items-center justify-center gap-2 text-xs text-foreground-subtle">
          <Icon name="triangle-alert" class="h-4 w-4" />
          {download.unsignedNotice}
        </p>
        <p class="mt-2 text-xs text-foreground-subtle">{download.privacyMicrocopy}</p>
      </div>
    </div>
  </Reveal>
</section>
