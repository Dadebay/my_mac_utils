---
import Icon from "./Icon.astro";
import Mockup from "./Mockup.astro";
import Reveal from "./Reveal.astro";
import type { IconName } from "./icons";

interface Props {
  id?: string;
  title: string;
  description: string;
  points?: string[];
  note?: string;
  image?: string;
  imageAlt?: string;
  icon?: IconName;
  /** Görsel sağda dursun (bölümler dönüşümlü). */
  reverse?: boolean;
}

const { id, title, description, points = [], note, image, imageAlt, icon, reverse = false } = Astro.props;
---

<section id={id} class="px-4 py-16">
  <div
    class:list={[
      "mx-auto flex max-w-5xl flex-col items-center gap-10 md:flex-row",
      reverse && "md:flex-row-reverse",
    ]}
  >
    <Reveal class="w-full md:w-1/2">
      <Mockup src={image} alt={imageAlt ?? title} icon={icon} label={title} />
    </Reveal>

    <Reveal class="w-full md:w-1/2">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
      <p class="mt-3 text-foreground-muted">{description}</p>

      {
        points.length > 0 && (
          <ul class="mt-5 space-y-2.5">
            {points.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-foreground-muted">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-teal" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        note && (
          <p class="mt-5 inline-block rounded-full border border-glass-border px-3 py-1 text-xs text-foreground-subtle">
            {note}
          </p>
        )
      }
    </Reveal>
  </div>
</section>
