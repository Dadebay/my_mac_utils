---
import type { IconName } from "./icons";

/**
 * Lucide ikonlarının satır içi kopyaları.
 *
 * Eski site bunları `lucide-react` paketinden alıyordu; tanıtım sayfasında
 * on üç ikon için bir bileşen kütüphanesi taşımanın anlamı yok. Yollar
 * birebir aynı, yani görünüm değişmedi.
 */

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "", strokeWidth = 2 } = Astro.props;

const paths: Record<IconName, string> = {
  sparkles: `<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>`,
  gauge: `<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>`,
