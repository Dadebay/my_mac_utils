---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import { locales, issuesUrl, type Locale } from "../../i18n/ui";
import { content } from "../../i18n/content";
import { meta } from "../../i18n/meta";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const c = content[lang].destek;
const m = meta[lang].destek;
---

<Base lang={lang} title={m.title} description={m.description} path="destek">
  <Header lang={lang} path="destek" />

  <main id="main" class="flex-1 px-4 pb-24 pt-40">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight">{c.title}</h1>
      <p class="mt-3 text-foreground-muted">{c.description}</p>

      {/* İçerikte bir de e-posta kartı tanımlı, ama adres hiç girilmemiş;
          adres belli olduğunda ikinci kart olarak buraya eklenir. */}
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="glass-panel rounded-3xl p-6">
          <Icon name="bug" class="h-5 w-5 text-accent-blue" strokeWidth={1.75} />
          <h2 class="mt-3 font-medium">{c.issuesCard.title}</h2>
          <p class="mt-1 text-sm text-foreground-muted">{c.issuesCard.description}</p>
          <a
            href={issuesUrl}
            target="_blank"
            rel="noreferrer"
            class="mt-4 inline-block text-sm text-accent-blue underline underline-offset-4 active:scale-95"
          >
            {c.issuesCard.linkLabel}
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Base>
